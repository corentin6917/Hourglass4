rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: vérifie si l'utilisateur est le propriétaire
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Collection users - Lecture publique pour les amis, écriture propriétaire uniquement
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Collection usernames - Réservations gérées via Cloud Functions (admin)
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Collection friendRequests - Lecture et écriture limitées
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() &&
                   (resource.data.fromUserId == request.auth.uid ||
                    resource.data.toUserId == request.auth.uid);

      allow create: if isAuthenticated() &&
                     request.resource.data.fromUserId == request.auth.uid;

      allow update: if isAuthenticated() &&
                     resource.data.toUserId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                     (resource.data.fromUserId == request.auth.uid ||
                      resource.data.toUserId == request.auth.uid);
    }

    // Collection friendships - Lecture limitée aux participants
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() &&
                   (resource.data.user1Id == request.auth.uid ||
                    resource.data.user2Id == request.auth.uid);

      allow write: if isAuthenticated();
    }

    // Collection friendMessages - Messages entre amis
    match /friendMessages/{messageId} {
      // Lecture: uniquement l'expéditeur ou le destinataire
      allow read: if isAuthenticated() &&
                   (resource.data.fromUserId == request.auth.uid ||
                    resource.data.toUserId == request.auth.uid);

      // Création: uniquement l'expéditeur peut créer
      allow create: if isAuthenticated() &&
                     request.resource.data.fromUserId == request.auth.uid;

      // Mise à jour: uniquement le destinataire peut marquer comme lu
      allow update: if isAuthenticated() &&
                     resource.data.toUserId == request.auth.uid;

      // Suppression: expéditeur ou destinataire
      allow delete: if isAuthenticated() &&
                     (resource.data.fromUserId == request.auth.uid ||
                      resource.data.toUserId == request.auth.uid);
    }

    // Collection groupChats - Conversations de groupe
    match /groupChats/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.auth.uid in request.resource.data.adminIds;

      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.adminIds ||
        (
          request.auth.uid in resource.data.memberIds &&
          request.resource.data.adminIds == resource.data.adminIds &&
          request.resource.data.memberIds == resource.data.memberIds &&
          request.resource.data.createdBy == resource.data.createdBy
        )
      );

      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds;
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/groupChats/$(groupId)).data.memberIds;
        allow update, delete: if false;
      }
    }

    // Collection notifications - Mentions et alertes
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.toUserId == request.auth.uid;
    }

    // Collection grainTransfers - Transfusions de grains
    match /grainTransfers/{transferId} {
      // Lecture: uniquement l'expéditeur ou le destinataire
      allow read: if isAuthenticated() &&
                   (resource.data.fromUserId == request.auth.uid ||
                    resource.data.toUserId == request.auth.uid);

      // Création: uniquement l'expéditeur peut créer
      allow create: if isAuthenticated() &&
                     request.resource.data.fromUserId == request.auth.uid &&
                     request.resource.data.grainAmount > 0;

      // Pas de mise à jour ou suppression (immuable)
      allow update: if false;
      allow delete: if false;
    }

    // Collection goals - Objectifs quotidiens des utilisateurs
    match /goals/{goalId} {
      // Lecture: uniquement le propriétaire
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Création: uniquement le propriétaire
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Mise à jour: uniquement le propriétaire
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Suppression: uniquement le propriétaire
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Collection victories - Victoires des utilisateurs (photos avec objectifs)
    match /victories/{victoryId} {
      // Lecture: tous les utilisateurs authentifiés peuvent lire les victoires
      allow read: if isAuthenticated();

      // Création: uniquement le propriétaire peut créer sa propre victoire
      allow create: if isAuthenticated() &&
                     request.resource.data.userId == request.auth.uid;

      // Mise à jour: pour booster ou commenter (incrémentation des compteurs)
      allow update: if isAuthenticated();

      // Suppression: uniquement le propriétaire ou pour nettoyage automatique
      allow delete: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Sous-collection comments - Commentaires sur les victoires
      match /comments/{commentId} {
        // Lecture: tous les utilisateurs authentifiés
        allow read: if isAuthenticated();

        // Création: utilisateur authentifié peut commenter
        allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;

        // Suppression: uniquement l'auteur du commentaire
        allow delete: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid;

        // Pas de mise à jour (les commentaires sont immuables)
        allow update: if false;
      }
    }
  }
}
